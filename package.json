{
  "name": "orbit-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:link": "supabase link --project-ref sumtrbejlwbxgutxgbum",
    "db:push": "supabase db push",
