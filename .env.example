# ============================================================================
# Orbit Works CRM — Environment Configuration
# ============================================================================
# Copy to .env.local and fill in. .env.local is gitignored and must never be
# committed.
#
# Supabase values: Dashboard → Project Settings → API
# ============================================================================

# --- Supabase (required) ----------------------------------------------------

# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon/publishable key. Safe to expose in the browser: RLS constrains it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. BYPASSES ROW LEVEL SECURITY — server-side only.
# Required for the public lead intake route and for inviting users.
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Lead intake (required in production) -----------------------------------

# Shared secret the website contact form sends as the x-orbit-lead-secret
# header when POSTing to /api/leads. Without it the route rejects every
# request, so an unset value fails closed rather than open.
# Generate with: openssl rand -base64 32
LEAD_INTAKE_SECRET=

# --- Session ----------------------------------------------------------------

# Minutes of inactivity before automatic logout (brief §01).
SESSION_IDLE_TIMEOUT_MINUTES=60
